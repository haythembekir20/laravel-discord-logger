{
    "name": "haythem-bekir/laravel-discord-logger",
    "description": "Laravel package for sending log notifications to Discord via webhooks with real-time alerts and daily reports",
    "keywords": ["laravel", "discord", "logging", "webhook", "notifications", "monolog"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Haythem Bekir",
            "email": "your-email@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/queue": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "HaythemBekir\\DiscordLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HaythemBekir\\DiscordLogger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HaythemBekir\\DiscordLogger\\DiscordLoggerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
